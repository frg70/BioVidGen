    "schemas": "tsx scripts/export-json-schema.ts",
    "secrets": "gitleaks git --redact --verbose .."
  },
  "dependencies": {
    "dexie": "4.4.7",
    "preact": "11.1.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/jsdom": "30.0.0",
    "@types/node": "22.20.5",
    "eslint": "10.14.0",
    "eslint-plugin-no-unsanitized": "4.1.5",
    "fake-indexeddb": "6.2.7",
    "fast-check": "4.10.2",
    "globals": "17.14.0",
    "jsdom": "31.0.0",
    "msw": "3.0.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0",
    "wxt": "0.21.5"
  }
